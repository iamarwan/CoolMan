# Local development settings. Copy to ".env" (same folder) and adjust if needed.
# Everything has a working default, so this file is optional for local use.

SABIL_ENV=development
SABIL_DATABASE_URL=postgresql+asyncpg://sabil:sabil_pass@localhost:5433/sabil_db?ssl=disable

# Admin login for the admin screens (development defaults: admin / admin123)
# SABIL_ADMIN_USERNAME=admin
# SABIL_ADMIN_PASSWORD=admin123

# Where uploaded photos are stored
# SABIL_UPLOAD_DIR=uploads

# Tests use a separate database (create it once: createdb -U sabil -p 5433 sabil_test)
# SABIL_TEST_DATABASE_URL=postgresql+asyncpg://sabil:sabil_pass@localhost:5433/sabil_test
