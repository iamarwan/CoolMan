# ─────────────────────────────────────────────────────────────────────────────
# INACTIVE UNTIL DEPLOYMENT. Copy to deploy/.env.production on the SERVER and
# fill in every value. Never commit the filled-in file (it is git-ignored).
# The API refuses to start in production if the secrets below are left weak.
# ─────────────────────────────────────────────────────────────────────────────

# Your API domain, e.g. api.yourapp.com (DNS A record -> server IP)
API_DOMAIN=api.example.com

# Database (only reachable inside Docker)
POSTGRES_USER=sabil
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=sabil

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SABIL_JWT_SECRET=CHANGE_ME_at_least_32_random_characters

# Admin login (12+ characters)
SABIL_ADMIN_USERNAME=admin
SABIL_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Other websites allowed to call the API from a browser. The phone app and the
# built-in admin panel (https://API_DOMAIN/admin) do not need this: leave empty.
SABIL_CORS_ORIGINS=

# Optional tuning
# SABIL_USER_TOKEN_MINUTES=43200
# SABIL_MAX_UPLOAD_MB=8
